# Discord Configuration
DISCORD_TOKEN=your_discord_bot_token_here

# Local Whisper Configuration
# Options: tiny, base, small, medium, large
# "tiny" or "base" is recommended for standard CPUs / MacBooks
WHISPER_MODEL=base

# LLM Summarization API Configuration (OpenAI Compatible)
# Works with OpenAI, Groq, local LM Studio, vLLM, Ollama, etc.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=llama3
